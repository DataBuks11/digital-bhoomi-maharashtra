# Server Configuration
PORT=3000
NODE_ENV=production

# MCP Static Authentication (Codex & Direct CLI)
# Set a strong random secret token for Codex Bearer authentication
MCP_API_KEY=your_secure_mcp_api_key_here

# MCP OAuth 2.1 Configuration (ChatGPT Custom Connector)
# Cryptographic secret for signing JWT access tokens (min 32 characters)
# If left empty, an ephemeral secret is generated at runtime
OAUTH_JWT_SECRET=your_32_character_oauth_jwt_signing_secret_here

# Custom OAuth Issuer URL (Defaults to https://${RAILWAY_PUBLIC_DOMAIN} or production host)
OAUTH_ISSUER_URL=https://qorvex-vgil-backend-production.up.railway.app

# Pre-registered Static Client (Optional - ChatGPT also supports Dynamic Registration RFC 7591)
OAUTH_CLIENT_ID=chatgpt-mcp-connector
OAUTH_CLIENT_SECRET=optional_preconfigured_client_secret

# Production CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://chatgpt.com,https://vgipl-website.vercel.app

# LLM Integration (TokenHarbor Router - DeepSeek V4.1 Flash)
LLM_BASE_URL=https://tokenharbor.ai/v1
LLM_API_KEY=your_tokenharbor_api_key_here
LLM_MODEL=deepseek-v4.1-flash:free
