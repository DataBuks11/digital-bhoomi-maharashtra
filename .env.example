# =========================================================================
# Digital Bhoomi Maharashtra - Environment Configuration
# =========================================================================

# Application Port (Development)
PORT=5173

# Supabase PostgreSQL Database, Auth & Storage (Optional)
# If left empty, Digital Bhoomi Maharashtra runs in offline demonstration mode
# with high-fidelity browser localStorage persistence.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
