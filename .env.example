# Server Configuration
PORT=3000

# MCP Authentication (Required for POST /mcp if set)
# Use a long, random secret token in production
MCP_API_KEY=your_secure_mcp_api_key_here

# LLM Integration (TokenHarbor Router - DeepSeek V4.1 Flash)
LLM_BASE_URL=https://tokenharbor.ai/v1
LLM_API_KEY=your_tokenharbor_api_key_here
LLM_MODEL=deepseek-v4.1-flash:free
